# libsodium 1.0.22 (ISC). Windows: asset oficial MinGW fixado por SHA256; demais sistemas: pkg-config.
if(WIN32)
  option(GESTAOEQUIPAMENTOS_FETCH_DEPENDENCIES "Baixa dependências binárias fixadas durante a configuração" ON)
else()
  option(GESTAOEQUIPAMENTOS_FETCH_DEPENDENCIES "Baixa dependências binárias fixadas durante a configuração" OFF)
endif()
include(FetchContent)

if(WIN32 AND GESTAOEQUIPAMENTOS_FETCH_DEPENDENCIES)
  if(MSVC)
    message(FATAL_ERROR "O pacote libsodium fixado é MinGW. Use o kit Qt MinGW ou desligue GESTAOEQUIPAMENTOS_FETCH_DEPENDENCIES e forneça sodium::sodium.")
  endif()
  FetchContent_Declare(libsodium_mingw
    URL https://github.com/jedisct1/libsodium/releases/download/1.0.22-RELEASE/libsodium-1.0.22-mingw.tar.gz
    URL_HASH SHA256=1d99e0afaf27bce664249232e9dc628ae6bb7b49f0ab53ad6db372b028a35d9d
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(libsodium_mingw)
  set(_sodium_root "${libsodium_mingw_SOURCE_DIR}/libsodium-win64")
  if(NOT EXISTS "${_sodium_root}/bin/libsodium-26.dll" OR NOT EXISTS "${_sodium_root}/lib/libsodium.dll.a")
    message(FATAL_ERROR "Layout inesperado do pacote libsodium MinGW em ${_sodium_root}.")
  endif()
  add_library(sodium::sodium SHARED IMPORTED GLOBAL)
  set_target_properties(sodium::sodium PROPERTIES
    IMPORTED_LOCATION "${_sodium_root}/bin/libsodium-26.dll"
    IMPORTED_IMPLIB "${_sodium_root}/lib/libsodium.dll.a"
    INTERFACE_INCLUDE_DIRECTORIES "${_sodium_root}/include")
  set(GESTAOEQUIPAMENTOS_SODIUM_DLL "${_sodium_root}/bin/libsodium-26.dll")
elseif(NOT TARGET sodium::sodium)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(SODIUM REQUIRED IMPORTED_TARGET libsodium>=1.0.18)
  add_library(sodium::sodium ALIAS PkgConfig::SODIUM)
endif()

# QtKeychain 0.17.0 (BSD-3-Clause). Windows: fontes no commit da tag, biblioteca estática sobre o Credential Store;
# demais sistemas: pacote Qt6Keychain. O alvo gestaoequipamentos_keychain é o único ponto de ligação.
add_library(gestaoequipamentos_keychain INTERFACE)
if(WIN32 AND GESTAOEQUIPAMENTOS_FETCH_DEPENDENCIES)
  set(_keychain_exclude)
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
    set(_keychain_exclude EXCLUDE_FROM_ALL)
  endif()
  FetchContent_Declare(qtkeychain
    GIT_REPOSITORY https://github.com/frankosterfeld/qtkeychain.git
    GIT_TAG 875f77d9f61bd97fd84cca47ce3bc71186dfbd09
    ${_keychain_exclude})
  foreach(_option BUILD_SHARED_LIBS BUILD_TESTING)
    if(DEFINED ${_option})
      set(_keychain_saved_${_option} "${${_option}}")
    endif()
  endforeach()
  set(BUILD_WITH_QT5 OFF)
  set(BUILD_TRANSLATIONS OFF)
  set(BUILD_TEST_APPLICATION OFF)
  set(BUILD_QTQUICK_DEMO OFF)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_TESTING OFF)
  set(USE_CREDENTIAL_STORE ON)
  set(USE_COMPAT_NAMING_SCHEME OFF)
  FetchContent_MakeAvailable(qtkeychain)
  foreach(_option BUILD_SHARED_LIBS BUILD_TESTING)
    if(DEFINED _keychain_saved_${_option})
      set(${_option} "${_keychain_saved_${_option}}")
    else()
      unset(${_option})
    endif()
  endforeach()
  if(NOT TARGET qt6keychain)
    message(FATAL_ERROR "O QtKeychain fixado não gerou o alvo qt6keychain.")
  endif()
  # Biblioteca estática: sem isso o cabeçalho exportado declara dllimport.
  target_compile_definitions(qt6keychain PUBLIC QT6KEYCHAIN_STATIC_DEFINE)
  target_link_libraries(gestaoequipamentos_keychain INTERFACE qt6keychain)
else()
  find_package(Qt6Keychain REQUIRED)
  if(TARGET Qt6Keychain::Qt6Keychain)
    target_link_libraries(gestaoequipamentos_keychain INTERFACE Qt6Keychain::Qt6Keychain)
  elseif(TARGET qt6keychain)
    target_link_libraries(gestaoequipamentos_keychain INTERFACE qt6keychain)
  else()
    target_link_libraries(gestaoequipamentos_keychain INTERFACE ${QTKEYCHAIN_LIBRARIES})
    target_include_directories(gestaoequipamentos_keychain INTERFACE ${QTKEYCHAIN_INCLUDE_DIRS})
  endif()
endif()

function(gestaoequipamentos_copy_runtime_dlls target)
  if(WIN32 AND GESTAOEQUIPAMENTOS_SODIUM_DLL)
    add_custom_command(TARGET ${target} POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${GESTAOEQUIPAMENTOS_SODIUM_DLL}" "$<TARGET_FILE_DIR:${target}>")
  endif()
endfunction()
